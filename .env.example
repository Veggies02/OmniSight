# OmniSight QA Dashboard Environment Configuration
# Copy this template to .env.local to customize your local development settings.
#
# SECURITY GUIDELINE:
# - NEVER store GitHub Personal Access Tokens (PAT), API keys, or private secrets in client-side .env files.
# - All GitHub write actions and token authorization are handled exclusively by the server-side orchestrator.

# Base URL for OmniSight Backend API (FastAPI)
# In local development with Vite dev server proxy, default is /api
# Direct URL example: http://localhost:8000/api
VITE_API_BASE_URL=/api

# Network request timeout in milliseconds (default: 10000ms = 10 seconds)
VITE_API_TIMEOUT_MS=10000

# Mock data fallback toggle: when true, dashboard gracefully displays demo data if backend is unreachable
VITE_ENABLE_MOCK_FALLBACK=true
