# OmniSight Environment Configuration Template
# Copy this template to .env.local to customize your local development settings.

# ==============================================================================
# 1. CLIENT-SIDE (QA Dashboard React Frontend)
# ==============================================================================
# CRITICAL SECURITY RULE:
# - NEVER store GitHub Personal Access Tokens (PAT), write credentials, or secrets in client-side .env files.
# - Only variables prefixed with VITE_* are visible to browser code.
# - All GitHub write actions and token authorization are handled exclusively by the server-side service.

# Base URL for OmniSight Backend API (FastAPI)
# In local development with Vite dev server proxy, default is /api
# Direct URL example: http://localhost:8000/api
VITE_API_BASE_URL=/api

# Network request timeout in milliseconds (default: 10000ms = 10 seconds)
VITE_API_TIMEOUT_MS=10000

# Mock data fallback toggle: when true, dashboard gracefully displays demo data if backend is unreachable
VITE_ENABLE_MOCK_FALLBACK=true

# ==============================================================================
# 2. SERVER-SIDE (FastAPI Backend, Orchestrator & CLI Services Only)
# ==============================================================================
# Privileged GitHub credentials MUST NEVER be prefixed with VITE_*
# Configure these in your backend environment (e.g. backend/.env or system environment)

# GitHub Personal Access Token or GitHub Actions Token for branch & PR creation
# GITHUB_TOKEN=ghp_exampleTokenDoNotCommitToGit

# GitHub API Base URL (defaults to https://api.github.com)
# GITHUB_API_BASE_URL=https://api.github.com

# Default base branch for repair branches (defaults to main)
# OMNISIGHT_GITHUB_DEFAULT_BASE_BRANCH=main

# Default repository target in owner/repo format
# OMNISIGHT_GITHUB_DEFAULT_REPO=Veggies02/OmniSight
