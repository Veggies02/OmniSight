# OmniSight Environment Configuration

# VLM Provider configuration
# Options: "mock" (default for testing/offline), "gemini", "openai"
OMNISIGHT_VLM_PROVIDER=mock

# Model identifier
# For Gemini: e.g. "gemini-1.5-flash", "gemini-1.5-pro", "gemini-2.5-flash"
# For OpenAI: e.g. "gpt-4o", "gpt-4o-mini"
OMNISIGHT_VLM_MODEL=gemini-1.5-flash

# API Credentials (never commit real credentials)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: Custom API Base URL (for enterprise proxies / gateways)
# OMNISIGHT_API_BASE_URL=

# Request timeout in milliseconds (default: 30000)
OMNISIGHT_VLM_TIMEOUT_MS=30000

# Maximum retries for transient errors (default: 2)
OMNISIGHT_VLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# Backend Development Proxy & Operator Token Configuration (Step 4.5 & 4.6)
# ------------------------------------------------------------------------------
# NOTE: The operator token is used by the server-side Vite development proxy to
# attach the X-Operator-Token header to proxied requests.
# SECURITY INVARIANT:
# - NEVER prefix with VITE_ (e.g., do NOT use VITE_OPERATOR_TOKEN).
# - NEVER expose or commit real operator tokens to Git or browser storage.
# - This proxy is a development gate, not production-grade user authentication.
OPERATOR_TOKEN=
# OMNISIGHT_OPERATOR_TOKEN=

# Backend target for the local Vite dev proxy (default: http://127.0.0.1:8000)
# BACKEND_PROXY_TARGET=http://127.0.0.1:8000

