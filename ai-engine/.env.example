# OmniSight AI Engine Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file or real API keys to git.

# Provider: 'mock' (default for offline/tests) or 'gemini'
VLM_PROVIDER=mock

# Model selection (e.g. gemini-2.0-flash, gemini-1.5-flash)
VLM_MODEL=gemini-2.0-flash

# API Credentials (leave empty when using mock provider)
VLM_API_KEY=your_gemini_api_key_here

# Network and reliability settings
VLM_TIMEOUT_SECONDS=60
VLM_MAX_RETRIES=3